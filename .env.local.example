# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project Settings → Environment Variables for
# production.

# Google Analytics 4 measurement ID. Leave unset to keep GA4 disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend API key, used by app/api/contact/route.ts to send contact form
# submissions by email. Get one free at https://resend.com/api-keys
RESEND_API_KEY=

# Optional — overrides the email address contact form submissions are sent
# to. Defaults to maria.sanchez011602@gmail.com if unset.
CONTACT_TO_EMAIL=
